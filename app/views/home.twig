<section class="expert">
    <div class="container">
        <h2>{{ t('expert_before') }}&nbsp;<em>{{ t('expert_accent') }}</em>&nbsp;{{ t('expert_after') }}</h2>
        <p>{{ t('expert_desc') }}</p>
        <button class="btn-brand-red" type="button" data-quote-open>{{ t('expert_cta') }}</button>
