{% include 'header.twig' %}

<!-- ============================================================ HERO -->
<section class="hero hero--v">
    <div id="heroCarousel" class="carousel slide carousel-fade">

        <div class="carousel-inner">
            {% for slider in sliderList %}
            <div class="carousel-item{{ loop.first ? ' active' : '' }}">
                <div class="hero__media{{ slider["slider_bg"] ? '' : ' hero__media--empty' }}">
                    {% if loop.index == 1 %}
                        <video src="assets/cloud/videos/hero-bg.mp4" autoplay loop muted playsinline poster="{{ slider["slider_bg"] }}" class="hero__media-video"></video>
                    {% elseif loop.index == 3 %}
                        <video src="assets/cloud/videos/extrusion-warehouse.mp4" autoplay loop muted playsinline poster="{{ slider["slider_bg"] }}" class="hero__media-video"></video>
                    {% elseif loop.index == 4 %}
                        <video src="assets/cloud/videos/coextrusion.mp4" autoplay loop muted playsinline poster="{{ slider["slider_bg"] }}" class="hero__media-video"></video>
                    {% elseif slider["slider_bg"] %}
                        <img src="{{ slider["slider_bg"] }}?v={{ site['asset_version'] }}" alt="{{ slider["slider_name"] }}" {{ loop.first ? 'fetchpriority="high"' : '' }}>
                    {% endif %}
                </div>
                <div class="hero__caption">
                    <div class="container">
                        {# Dikey sayı sütununun kapladığı yer #}
                        <div class="hero__spacer" aria-hidden="true"></div>
                        <div class="hero__box">
                            <span class="hero__label">{{ site['site_name'] }}</span>
                            <h1 class="hero__title">{{ slider["slider_name"] }}</h1>
                            {% if slider["slider_content"] %}
                                <p class="hero__text">{{ slider["slider_content"] }}</p>
                            {% endif %}
                            {% if slider["slider_button"] %}
                                <a class="btn-arrow" href="{{ lang_url(slider["slider_url"]) }}">{{ slider["slider_button"] }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        {% if sliderList|length > 1 %}
        <div class="hero__indicators--v">
            <div class="container">
                <div class="hero__nums" id="heroNums">
                    {% for slider in sliderList %}
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{ loop.index0 }}"
                                class="{{ loop.first ? 'active' : '' }}"
                                aria-label="{{ loop.index }}">{{ '%02d'|format(loop.index) }}</button>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        <div class="hero__search">
            <div class="container">
                <form action="{{ lang_url('arama') }}" method="get" role="search">
                    <button type="submit" aria-label="{{ t('search_button') }}"><i class="ti-search"></i></button>
                    <input type="search" name="q" placeholder="{{ t('search_placeholder') }}">
                </form>
            </div>
        </div>

    </div>
</section>

<!-- ==================================================== ÇÖZÜMLERİMİZ -->
{% if categoryList %}
<section class="section-pad">
    <div class="container">
        <h2 class="section-title">{{ t('home_solutions') }}</h2>
        <p class="section-intro">{{ t('home_solutions_desc') }}</p>

        <div class="row g-4">
            {% for category in categoryList %}
            <div class="col-lg-4 col-md-6">
                <a class="solution-card" href="{{ lang_url('kategori/' ~ category["category_url"]) }}">

                    <div class="solution-card__media{{ category["category_image"] ? '' : ' solution-card__media--empty' }}">
                        {% if category["category_image"] %}
                            <img src="{{ category["category_image"] }}?v={{ site['asset_version'] }}" alt="{{ category["category_name"] }}" loading="lazy">
                        {% endif %}
                    </div>

                    <div class="solution-card__top">
                        <h3 class="solution-card__name">{{ category["category_name"] }}</h3>
                        {# Site logosunda alfa yok; koyu zemin için beyaz sürüm #}
                        <img class="solution-card__mark" src="assets_new/images/logo-white.png?v={{ site['asset_version'] }}" alt="">
                    </div>

                    <div class="solution-card__bottom">
                        {% if category["category_desc"] %}
                            <p>{{ category["category_desc"] }}</p>
                        {% endif %}
                        <span class="btn-arrow">{{ t('cta_view_products') }}</span>
                    </div>

                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- ========================================================= NEDEN BİZ -->
<section class="section-pad section-why" style="background: var(--c-bg-alt); overflow: hidden;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5 col-md-12">
                <div class="why__media">
                    <img src="assets/cloud/pages/about-vertical.webp" alt="Cappafe Üretim Hattı" class="img-fluid rounded shadow-lg" style="max-height: 580px; width: 100%; object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-7 col-md-12">
                <div class="why__content">
                    <span class="why__label">{{ t('why_subtitle') }}</span>
                    <h2 class="why__title">{{ t('why_title') }}</h2>
                    <div class="why__desc">
                        <p class="why__typewriter" id="whyTypewriter" data-text-tr="25 yılı aşkın süredir Bursa'daki ileri teknoloji ko-ekstrüzyon hatlarımızda ABS, PMMA, PE ve ABS/PMMA plastik levhalar üretiyoruz. Otomotivden medikale, beyaz eşyadan reklama kadar birçok sektöre küresel standartlarda, yüksek dayanımlı ve şekillendirilebilir yüzey çözümleri sunuyoruz. Çevreye duyarlı ham maddeler ve sıfır hata kalite politikamızla üretimin her aşamasında yanınızdayız." data-text-en="For over 25 years, we have been producing ABS, PMMA, PE, and ABS/PMMA plastic sheets in our high-tech co-extrusion lines in Bursa. We offer high-durability and formable surface solutions at global standards to many sectors from automotive to medical, white goods to advertising. We are beside you at every stage of production with our eco-friendly raw materials and zero-defect quality policy."></p>
                    </div>
                    <div class="why__buttons mt-4">
                        <a href="{{ lang_url('sayfa/hakkimizda') }}" class="btn-brand-red">{{ t('cta_find_out_more') }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

